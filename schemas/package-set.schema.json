{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hyprland-copr:package-set",
  "title": "Hyprland COPR package set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "release_set", "packages"],
  "properties": {
    "schema": {"const": 1},
    "release_set": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[1-9][0-9]*$"
    },
    "packages": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9+.-]*$"},
      "additionalProperties": {"$ref": "#/$defs/package"}
    }
  },
  "$defs": {
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstream",
        "version",
        "source_commit",
        "source_sha256",
        "tier",
        "depends_on"
      ],
      "properties": {
        "upstream": {
          "type": "string",
          "pattern": "^https://"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9][0-9A-Za-z._+~^]*$"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tier": {
          "enum": ["core", "application", "compatibility"]
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        }
      }
    }
  }
}

From: Hyprland COPR Maintainer <noreply@example.invalid>
Subject: [PATCH] Quote xcur2png input paths safely

Prevent an apostrophe in a cursor path from terminating the shell-quoted
argument passed to xcur2png.

---
 hyprcursor-util/src/main.cpp | 19 +++++++++++++++++--
 1 file changed, 17 insertions(+), 2 deletions(-)

diff --git a/hyprcursor-util/src/main.cpp b/hyprcursor-util/src/main.cpp
index 8ec748b..cf4006d 100644
--- a/hyprcursor-util/src/main.cpp
+++ b/hyprcursor-util/src/main.cpp
@@ -237,1 +237,15 @@
+static std::string shellQuote(const std::string& value) {
+    std::string quoted = "'";
+
+    for (const char character : value) {
+        if (character == '\'')
+            quoted += "'\\''";
+        else
+            quoted += character;
+    }
+
+    quoted += "'";
+    return quoted;
+}
+
 static std::optional<std::string> extractXTheme(const std::string& xpath_, const std::string& out_) {
@@ -285,2 +299,3 @@
-        const auto OUT = spawnSync(std::format("rm -f /tmp/hyprcursor-util/* && cd /tmp/hyprcursor-util && xcur2png '{}' -d /tmp/hyprcursor-util 2>&1",
-                                               std::filesystem::canonical(xcursor.path()).string()));
+        const auto OUT = spawnSync(
+            std::format("rm -f /tmp/hyprcursor-util/* && cd /tmp/hyprcursor-util && xcur2png {} -d /tmp/hyprcursor-util 2>&1",
+                        shellQuote(std::filesystem::canonical(xcursor.path()).string())));

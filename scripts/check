#!/usr/bin/env sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

case "${1:-}" in
    --metadata-only) ;;
    "")
        if ! command -v rpmspec >/dev/null 2>&1 || ! command -v rpmlint >/dev/null 2>&1; then
            exec "$repo_root/scripts/check-container"
        fi
        ;;
    *) echo "usage: $0 [--metadata-only]" >&2; exit 2 ;;
esac

python3 scripts/package_set.py package-set.yaml
python3 scripts/repository_check.py --root "$repo_root"
python3 -m json.tool schemas/package-set.schema.json >/dev/null
python3 -m unittest discover -s tests -v

if [ "${1:-}" = --metadata-only ]; then
    echo "Metadata-only check: RPM and source checks were explicitly excluded."
    exit 0
fi

for spec in packages/*/*.spec; do
    rpmspec --parse "$spec" >/dev/null
done
rpmlint packages/*/*.spec
python3 scripts/source_check.py --root "$repo_root" --download
